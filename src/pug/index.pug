doctype html
html
	head
		meta(charset='UTF-8')
		meta(name='viewport', content='width=device-width, initial-scale=1.0')
		link(rel='stylesheet', href='./css/style.css')
		title Howard Stark
	body
		.container
			header.l-header
				.wrapper
					a.l-header__brand.trans(href='#')
						img(src='../src/images/logos/header-logo.svg', alt='' width='48' height='48' loading='eager')
						| Howard
					nav.l-header__nav
						ul.c-nav__list
							li.c-nav__item
								a.c-nav__link.is-current(href='#') Home
							li.c-nav__item
								a.c-nav__link(href='#') About
							li.c-nav__item
								a.c-nav__link(href='#') Work
							li.c-nav__item
								a.c-nav__link(href='#') Service
							li.c-nav__item
								a.c-nav__link(href='#') Blog
							li.c-nav__item
								a.c-nav__link(href='#') Contact
						a.c-contact__button.trans(href='#') howard@gmail.com

			.p-top-keyvisual
				.wrapper
					img(src='../src/images/keyvisual-bg-howardstark.png', alt='Howard Stark', width='536' height='536' loading='eager')
					.p-top-keyvisual__content
						.p-top-keyvisual__eyebrow
							span.c-eyebrow__line
							p.c-eyebrow__text Visual Designer Webflow Developer
						h1.c-keyvisual__title Hello, I’m Howard Stark.
						p.c-keyvisual__description Hello, I'm a passionate Visual Designer, Webflow Developer and part time freelancer with a keen eye for details.
						.p-top-keyvisual__actions
							a.c-button.c-button--primary.trans(href='#') Say Hello
							a.c-button.c-button--secondary.trans(href='#')
								| View Portfolio
								img(src='../src/images/icons/keyvisual-icon-arrow-right.svg', alt='', width='24' height='24' loading='eager')

			.p-top-clients
				.wrapper
					.p-clients__intro
						h2.c-heading--secondary I work with 524+ big companies worldwide.
						p.c-text.c-text--description I specialize in UI/UX & Graphic Design and my passion is all about building elegant and professional user interfaces.
					ul.p-clients__list.c-list
						li.c-client-list__item
								img(src='../src/images/logos/clients-logo-spotify.svg', alt='', width='200' height='96' loading='lazy')
						li.c-client-list__item
								img(src='../src/images/logos/clients-logo-coinbase.svg', alt='', width='200' height='96' loading='lazy')
						li.c-client-list__item
								img(src='../src/images/logos/clients-logo-slack.svg', alt='', width='200' height='96' loading='lazy')
						li.c-client-list__item
								img(src='../src/images/logos/clients-logo-dropbox.svg', alt='', width='200' height='96' loading='lazy')
						li.c-client-list__item
								img(src='../src/images/logos/clients-logo-webflow.svg', alt='', width='200' height='96' loading='lazy')
						li.c-client-list__item
								img(src='../src/images/logos/clients-logo-zoom.svg', alt='', width='200' height='96' loading='lazy')

			.p-top-testimonials
				.wrapper
					.p-testimonials__content
						h2.c-heading--secondary What my clients say about my work!
						.c-testimonials__slider
							p.c-testimonials__text “Great Designer, does great work and is very flexible with change. if you’re a programmer and are looking for UI/UX designer is definitely well qualified for the job.”
							.c-testimonials__author
									strong.c-testimonials__author-name James Quincey
									span.c-testimonials__author-position CEO of Coca ColA
						.c-testimonials__actions
							button.c-slider__button
								img(src='../src/images/icons/testimonials-icon-black-caret-left.svg', alt='', width='24' height='24' loading='lazy')
								img(src='../src/images/icons/testimonials-icon-white-caret-left.svg', alt='', width='24' height='24' loading='lazy')
							.c-slider__dots
								span.c-slider__dot.is-active
								span.c-slider__dot
								span.c-slider__dot
								span.c-slider__dot
								span.c-slider__dot
							button.c-slider__button
								img(src='../src/images/icons/testimonials-icon-black-caret-right.svg', alt='', width='24' height='24' loading='lazy')
								img(src='../src/images/icons/testimonials-icon-white-caret-right.svg', alt='', width='24' height='24' loading='lazy')
					img(src='../src/images/testimonials-bg-howardstark.png', alt='Howard Stark', width='464' height='512' loading='lazy')

			.p-top-about
				.wrapper
					img(src='../src/images/about-avt-howardstark.png', alt='Howard Stark', width='192' height='192' loading='lazy')
					.p-about__content
						h2